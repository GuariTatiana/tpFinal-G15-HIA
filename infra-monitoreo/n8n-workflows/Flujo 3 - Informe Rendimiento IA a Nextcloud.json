      "name": "Consultar Metricas Prometheus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        496,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const resultados = $json.data.result || [];\nconst total = resultados.length;\nconst activos = resultados.filter(r => r.value[1] === '1').length;\nconst estado = activos === total ? 'OPTIMO' : 'DEGRADADO';\n\nconst reporte = `# Informe Automatizado de Rendimiento (Asistido por Analisis)\n- Fecha: ${new Date().toISOString()}\n- Servicios Monitoreados: ${total}\n- Servicios Activos (UP): ${activos}\n- Diagnostico: ${estado}\n- Recomendacion: ${estado === 'OPTIMO' ? 'Sin anomalias detectadas. No se requieren reinicios.' : 'Se detectaron nodos caidos. Requiere aprobacion humana antes de reiniciar contenedores.'}`;\n\nreturn [{ json: { estado, reporte, nombre_archivo: 'informe_rendimiento_' + Date.now() + '.md' } }];"
      },
      "id": "8762c620-c9bb-4601-ba6a-32b330212645",
      "name": "Analisis de Anomalias (Motor IA/Script)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        272
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=http://nextcloud_app/remote.php/dav/files/n8n-bot/informe_rendimiento_{{ $now.format('yyyy-MM-dd_HH-mm') }}.md",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/markdown",
        "body": "={{ $json.reporte || $json.output || JSON.stringify($json, null, 2) }}",
        "options": {}
      },
      "id": "8240f0cd-011d-4936-809d-8ee47045ead2",
      "name": "Guardar Informe en Nextcloud (WebDAV)",

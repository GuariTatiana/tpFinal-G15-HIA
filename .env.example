# Copiar a .env y completar. .env está en .gitignore: NUNCA se sube.
DB_NAME=canchas_db
DB_USER=postgres
DB_PASSWORD=cambiar_por_clave_larga
# Opcional: apuntar el backend a otra base (ej. dataset masivo en futbolgest-db).
# Requiere que el stack tp-futbolgest-docker esté levantado (red futbolgest-net).
# DB_HOST=futbolgest-db
# DB_APP_PASSWORD=clave_del_otro_postgres
JWT_SECRET=cambiar_por_secreto_aleatorio_de_32_o_mas_caracteres
# Origen(es) permitidos por CORS, separados por coma (URL pública del túnel)
CORS_ORIGIN=http://localhost:8080
APP_PORT=8080
# Solo para CI/CD (los completa el workflow; en local se usan las imágenes build)
# BACKEND_IMAGE=ghcr.io/guaritatiana/g15-backend:latest
# FRONTEND_IMAGE=ghcr.io/guaritatiana/g15-frontend:latest

# Copiar a .env y completar. .env está en .gitignore: NUNCA se sube.

# Base de datos PostgreSQL para Nextcloud
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=cambiar_por_clave_larga
POSTGRES_PORT=5433

# Administrador de Nextcloud (credenciales iniciales)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=cambiar_por_clave_larga

# Puertos y configuración de la aplicación
NEXTCLOUD_PORT=8080
CORS_ORIGIN=http://localhost:8080
APP_PORT=8080

# Secretos y tokens
JWT_SECRET=cambiar_por_secreto_aleatorio_de_32_o_mas_caracteres

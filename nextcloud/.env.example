# ==========================================
# Variables de Entorno - Nextcloud & Traefik
# ==========================================

# Zona Horaria
TZ=America/Argentina/Buenos_Aires

# Administrador de Nextcloud (Credenciales iniciales)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CambiarEstePasswordSeguro123!

# Configuración de Base de Datos PostgreSQL
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=NextcloudDbPassword456!
POSTGRES_PORT=5433

# Configuración de Puertos Locales en Host
NEXTCLOUD_PORT=8080
TRAEFIK_HTTP_PORT=8088
TRAEFIK_HTTPS_PORT=443

# Configuración de Traefik & Let's Encrypt
# Reemplazar con el dominio público o DynDNS asignado (ej: docs.tudominio.com o tudominio.duckdns.org)
TRAEFIK_DOMAIN=nextcloud.local
TRAEFIK_EMAIL=admin@tudominio.com
